---
import Projects from "../components/Projects.astro";
import ContactButtons from "../components/ContactButtons.astro";
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
import styles from "../styles/pages/home/home.module.scss";
---

<PortfolioLayout
  title="Home"
  description="Marco Ramirez. Web Developer and Rock Climber."
>
  <div class={styles.home}>
    <div class={styles.header}>
      <h2 class={styles.subHeader}>
        <span class={styles.flair}>Hey There!</span>
      </h2>
      <div class={styles.subHeader}>
        <span class={styles.subtitle}>I'm Marco Ramirez.</span>
      </div>
      <div class={styles.subHeader}>
        <span class={styles.subtitle}>
          Web Developer
          <span class={styles.flair}> and </span>
          Rock Climber.
        </span>
      </div>
      <ContactButtons align="start" />
    </div>
  </div>

  <Projects />
</PortfolioLayout>
