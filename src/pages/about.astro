---
import { Image } from "astro:assets";
import ContactButtons from "../components/ContactButtons.astro";
import SpotifyWidget from "../components/SpotifyWidget.astro";
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
import photo2 from "../assets/imgs/portfolio/about/photo2.JPG";
import photo3 from "../assets/imgs/portfolio/about/photo3.jpeg";
import styles from "../styles/pages/about/about.module.scss";
---

<PortfolioLayout
  title="About Me"
  description="I'm Marco Ramirez, a dedicated web developer with a passion for creating intuitive and dynamic web experiences. Rock climbing and web development are my two biggest passions, and I'm looking for a life where I can happily do both."
>
  <section class={styles.about}>
    <section class={styles.aboutMedia}>
      <button
        class={styles.imgContainer}
        type="button"
        aria-label="Marco Ramirez headshot"
        data-about-photo-toggle
      >
        <Image
          class={styles.image}
          src={photo2}
          width={800}
          height={800}
          alt="Marco Ramirez Headshot"
          data-about-photo
        />
        <Image
          class={styles.image}
          src={photo3}
          width={800}
          height={800}
          alt="ouchies"
          data-about-easter-egg
          hidden
        />
      </button>

      <div class={styles.mediaDetails}>
        <SpotifyWidget />
        <ContactButtons align="center" size={50} />
      </div>
    </section>
    <article class={styles.aboutContact}>
      <h1 class={styles.flair}>Some More Information</h1>
      <p>
        I'm Marco Ramirez, a dedicated web developer/seo specialist with a
        passion for creating intuitive and dynamic web experiences.
      </p>

      <p>
        I started making websites when I was 15, and fell in love with how
        personable and meaningful a good website could feel. I started to rock
        climb when I was 20, and fell in love with that too. Rock climbing and
        web development are my two biggest passions, and I'm looking for a life
        where I can happily do both.
      </p>

      <p>
        Feel free to{" "}
        <a
          class={styles.linkTo}
          target="_blank"
          rel="noreferrer"
          href="https://linkedin.com/in/marcoramirez001">reach out</a
        >{" "}
        if you have any questions or if you'd like to work together.
      </p>
    </article>
  </section>

  <script>
    const photoToggle = document.querySelector<HTMLButtonElement>(
      "[data-about-photo-toggle]",
    );
    const photo = document.querySelector<HTMLElement>("[data-about-photo]");
    const easterEgg = document.querySelector<HTMLElement>(
      "[data-about-easter-egg]",
    );

    if (photoToggle && photo && easterEgg) {
      let count = 0;
      photoToggle.addEventListener("click", () => {
        count += 1;
        if (count >= 8) {
          photo.hidden = true;
          easterEgg.hidden = false;
        }
      });
    }
  </script>
</PortfolioLayout>
