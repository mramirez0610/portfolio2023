---
import styles from "../../styles/components/climbing/climbingNav.module.scss";
---

<section class={styles.cNav} data-climbing-nav data-open="false">
  <nav class={styles.nav} aria-label="Climbing journal navigation">
    <div class={styles.portfolioLink}>
      <a class={styles.link} href="/">
        <span class={styles.iconSwap} aria-hidden="true">
          <svg
            class={styles.iconPrimary}
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="currentColor"
            viewBox="0 0 256 256"
          >
            <path
              d="M208,72H128V32a8,8,0,0,0-13.66-5.66l-96,96a8,8,0,0,0,0,11.32l96,96A8,8,0,0,0,128,224V184h80a16,16,0,0,0,16-16V88A16,16,0,0,0,208,72Zm0,96H120a8,8,0,0,0-8,8v28.69L35.31,128,112,51.31V80a8,8,0,0,0,8,8h88Z"
            ></path>
          </svg>
          <svg
            class={styles.iconHover}
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="currentColor"
            viewBox="0 0 256 256"
          >
            <path
              d="M152,72H128V32a8,8,0,0,0-13.66-5.66l-96,96a8,8,0,0,0,0,11.32l96,96A8,8,0,0,0,128,224V184h24a8,8,0,0,0,8-8V80A8,8,0,0,0,152,72Zm-8,96H120a8,8,0,0,0-8,8v28.69L35.31,128,112,51.31V80a8,8,0,0,0,8,8h24Zm80-88v96a8,8,0,0,1-16,0V80a8,8,0,0,1,16,0Zm-32,0v96a8,8,0,0,1-16,0V80a8,8,0,0,1,16,0Z"
            ></path>
          </svg>
        </span>
        <span>portfolio</span>
      </a>
    </div>

    <a class={styles.link} href="/climbing/">entries</a>
    <a class={styles.link} href="/climbing/about/">about</a>
  </nav>

  <button
    class={styles.mobileNavButton}
    type="button"
    aria-label="Open climbing journal navigation"
    aria-controls="climbing-mobile-nav"
    aria-expanded="false"
    data-climbing-nav-toggle
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="32"
      height="32"
      fill="currentColor"
      viewBox="0 0 256 256"
      aria-hidden="true"
    >
      <path
        d="M76,60A16,16,0,1,1,60,44,16,16,0,0,1,76,60Zm52-16a16,16,0,1,0,16,16A16,16,0,0,0,128,44Zm68,32a16,16,0,1,0-16-16A16,16,0,0,0,196,76ZM60,112a16,16,0,1,0,16,16A16,16,0,0,0,60,112Zm68,0a16,16,0,1,0,16,16A16,16,0,0,0,128,112Zm68,0a16,16,0,1,0,16,16A16,16,0,0,0,196,112ZM60,180a16,16,0,1,0,16,16A16,16,0,0,0,60,180Zm68,0a16,16,0,1,0,16,16A16,16,0,0,0,128,180Zm68,0a16,16,0,1,0,16,16A16,16,0,0,0,196,180Z"
      ></path>
    </svg>
  </button>

  <nav
    class={styles.mobileNav}
    id="climbing-mobile-nav"
    aria-label="Climbing journal mobile navigation"
    aria-hidden="true"
    data-climbing-mobile-nav
  >
    <div class={styles.navLinks}>
      <a class={styles.link} href="/">
        <span class={styles.iconSwap} aria-hidden="true">
          <svg
            class={styles.iconPrimary}
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="currentColor"
            viewBox="0 0 256 256"
          >
            <path
              d="M208,72H128V32a8,8,0,0,0-13.66-5.66l-96,96a8,8,0,0,0,0,11.32l96,96A8,8,0,0,0,128,224V184h80a16,16,0,0,0,16-16V88A16,16,0,0,0,208,72Zm0,96H120a8,8,0,0,0-8,8v28.69L35.31,128,112,51.31V80a8,8,0,0,0,8,8h88Z"
            ></path>
          </svg>
        </span>
        <span>portfolio</span>
      </a>
      <a class={styles.link} href="/climbing/">entries</a>
      <a class={styles.link} href="/climbing/about/">about</a>
    </div>
  </nav>
</section>

<script>
  const setupClimbingNav = (root: HTMLElement) => {
    if (root.dataset.ready === "true") return;

    const toggle = root.querySelector<HTMLButtonElement>(
      "[data-climbing-nav-toggle]",
    );
    const mobileNav = root.querySelector<HTMLElement>(
      "[data-climbing-mobile-nav]",
    );

    if (!toggle || !mobileNav) return;

    const setOpen = (open: boolean) => {
      root.dataset.open = String(open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute(
        "aria-label",
        open
          ? "Close climbing journal navigation"
          : "Open climbing journal navigation",
      );
      mobileNav.setAttribute("aria-hidden", String(!open));
    };

    toggle.addEventListener("click", () => {
      setOpen(root.dataset.open !== "true");
    });

    mobileNav.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) setOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && root.dataset.open === "true") {
        setOpen(false);
        toggle.focus();
      }
    });

    root.dataset.ready = "true";
  };

  document
    .querySelectorAll<HTMLElement>("[data-climbing-nav]")
    .forEach(setupClimbingNav);
</script>
